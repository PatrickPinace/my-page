---
const groups = [
  { label: 'Backend', items: ['Django', 'Python', 'JavaScript', 'PostgreSQL', 'MySQL'] },
  { label: 'Frontend', items: ['Astro', 'React', 'CSS', 'Tailwind'] },
  { label: 'Infra', items: ['Linux', 'MAC', 'Windows', 'Docker', 'VPS', 'GitHub Actions', 'Cloudflare'] },
  { label: 'AI', items: ['Lokalne modele', 'Ollama', 'Prompt engineering', 'Claude Code'] },
];
---

<div id="stack" class="reveal scroll-mt-20 px-6 pb-16 md:px-14 md:pb-18">
  <h2 class="mb-7 text-[28px] md:text-[40px]">Stack</h2>
  <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
    {groups.map((g) => (
      <div class="flex flex-col gap-3 border-t border-ink-800 pt-3.5">
        <div class="text-[13px] text-ink-500">{g.label}</div>
        <div class="flex flex-wrap gap-1.5">
          {g.items.map((item) => <span class="tag tag-neutral">{item}</span>)}
        </div>
      </div>
    ))}
  </div>
</div>
