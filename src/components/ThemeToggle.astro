---
/** Przełącznik Nocturne ↔ Ruda. Stan trzymany na <html data-theme>,
 *  zapisywany w localStorage. Skrypt ustawiający motyw przed pierwszym
 *  malowaniem jest w Base.astro - tu tylko obsługa kliknięcia. */
---

<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Zmień motyw kolorystyczny">
  <span class="swatch" aria-hidden="true"></span>
</button>

<script>
  // Delegacja na document zamiast getElementById + listener na elemencie:
  // Header (i ten przycisk) żyje w <slot />, więc przy każdej nawigacji
  // ClientRouter dostaje NOWY element DOM. Astro odróżnia skrypty po
  // treści (scriptsAlreadyRan w swap-functions.js) - ten sam tekst skryptu
  // (identyczny na każdej stronie, bo komponent jest wszędzie) odpala się
  // tylko RAZ w całej sesji SPA, więc listener podpięty bezpośrednio na
  // starym elemencie nigdy by nie trafił na nowy przycisk po swapie
  // (efekt zaobserwowany: przełącznik przestawał działać po wejściu w
  // podstronę projektu, do czasu pełnego przeładowania). Delegacja na
  // document nie ma tego problemu - document przeżywa swap niezmieniony.
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement)?.closest('#theme-toggle');
    if (!btn) return;
    const next = document.documentElement.dataset.theme === 'ruda' ? 'nocturne' : 'ruda';
    document.documentElement.dataset.theme = next;
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', next === 'ruda' ? '#14120f' : '#0e0f17');
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* tryb prywatny - motyw zadziała, po prostu się nie zapamięta */
    }
    // Kafle projektów i karuzela na podstronach mają jasne warianty zdjęć
    // przyciemnione osobno pod każdy motyw - muszą się dowiedzieć o zmianie.
    document.dispatchEvent(new CustomEvent('theme-change', { detail: { theme: next } }));
  });
</script>
