---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/paths';
import { webpSize } from '../lib/webp-size';
import { fileURLToPath } from 'node:url';

interface Props {
  project: CollectionEntry<'projects'>;
  index: number;
}

const { project, index } = Astro.props;
const { title, summary, stack, role, shots, screenshotAlt, tile, inProgress, inProgressLabel } = project.data;

// `tile` decyduje tylko o szerokości kafla w siatce (układ bento), NIE o jego
// proporcjach - te biorą się z realnych wymiarów pierwszej klatki galerii.
// Wcześniej kształt szedł w parze z szerokością i szerokie zrzuty (ortomielec
// 2.13:1, medi3 1.21:1) trafiały do wąskich pionowych kafli 3:4, gdzie przy
// object-contain zostawały wielkie puste pasy tła nad i pod zdjęciem.
const colSpan = tile === 'wide' ? 'md:col-span-4' : tile === 'tall' ? 'md:col-span-2' : 'md:col-span-3';

const screensDir = fileURLToPath(new URL('../../public/screens/', import.meta.url));
const firstShot = shots[0];
const firstFile = firstShot.kind === 'dark' ? `${firstShot.base}.webp` : `${firstShot.base}-nocturne.webp`;
const { width, height } = webpSize(screensDir + firstFile);

// Proporcje ograniczone do rozsądnego zakresu: bardzo płaski zrzut w wąskiej
// kolumnie dałby kafel wysokości paska, bardzo wysoki - kolumnę na pół ekranu.
const RATIO_MIN = tile === 'wide' ? 1.7 : 1.2;
const RATIO_MAX = tile === 'wide' ? 2.4 : 1.9;
const ratio = Math.min(RATIO_MAX, Math.max(RATIO_MIN, width / height));

const num = String(index + 1).padStart(2, '0');
---

<a
  href={url(`/projekty/${project.id}`)}
  class:list={['group reveal flex cursor-pointer flex-col gap-3.5 no-underline', colSpan]}
>
  {/* Wszystkie klatki galerii projektu leżą jedna na drugiej i przewijają się
      w tle (skrypt w ProjectsGrid), żeby na stronie głównej było widać więcej
      materiału niż jeden kadr. object-contain, nie -cover: klatki jednego
      projektu też mają różne proporcje między sobą (np. pełny widok vs wycinek
      okna), a kafel ma jedno aspect-ratio - przy -cover te odbiegające od niego
      traciłyby brzegi. Resztę miejsca dopełnia tło kontenera, tak jak
      w karuzeli na podstronie projektu. */}
  <div
    class="card-shots relative overflow-hidden rounded-[var(--radius-md)] shadow-[var(--shadow-sm)] transition-shadow duration-200 group-hover:shadow-[var(--shadow-md)]"
    style={`aspect-ratio: ${ratio}; background: var(--color-surface)`}
  >
    {shots.map((s, i) =>
      s.kind === 'dark' ? (
        <div class:list={['card-shot absolute inset-0 transition-transform duration-300 group-hover:scale-[1.03]', i === 0 && 'is-active']}>
          <img
            src={url(`/screens/${s.base}.webp`)}
            alt={i === 0 ? screenshotAlt : ''}
            aria-hidden={i === 0 ? undefined : 'true'}
            loading="lazy"
            class="h-full w-full object-contain"
          />
        </div>
      ) : (
        <div class:list={['card-shot shot-pair absolute inset-0 transition-transform duration-300 group-hover:scale-[1.03]', i === 0 && 'is-active']}>
          <img
            src={url(`/screens/${s.base}-nocturne.webp`)}
            alt={i === 0 ? screenshotAlt : ''}
            aria-hidden={i === 0 ? undefined : 'true'}
            loading="lazy"
            class="shot shot-nocturne h-full w-full object-contain"
          />
          <img
            src={url(`/screens/${s.base}-ruda.webp`)}
            alt=""
            aria-hidden="true"
            loading="lazy"
            class="shot shot-ruda h-full w-full object-contain"
          />
        </div>
      )
    )}

    {inProgress && (
      <div class="card-pill absolute left-4 top-4 flex items-center gap-1.5 border font-mono text-[11px]" style="border-color: var(--color-accent-700); color: var(--color-accent-300)">
        <span class="h-1.5 w-1.5 rounded-full" style="background: var(--color-accent-400); animation: nx-pulse 1.8s ease-in-out infinite"></span>
        {inProgressLabel}
      </div>
    )}

    <div
      class="absolute bottom-0 left-0 h-0.5 w-0 bg-[var(--color-accent)] transition-[width] duration-200 group-hover:w-full"
    ></div>

    {/* Napisy w pastylkach z własnym, prawie pełnym tłem - gradient nad
        screenem nie wystarczał, bo na jasnych zrzutach tekst i tak się gubił.
        Pastylka niesie kontrast ze sobą, niezależnie od tego, co pod nią. */}
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 flex translate-y-2 items-end justify-between gap-2 px-3 pb-3 font-mono text-xs opacity-0 transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100"
    >
      <span class="card-pill text-[var(--color-ink-300)]">rola: {role.join(', ')}</span>
      <span class="card-pill whitespace-nowrap text-[var(--color-accent-300)]">case study →</span>
    </div>
  </div>

  <div class="flex gap-3.5">
    <span class="pt-1 font-mono text-xs text-[var(--color-ink-600)] transition-colors group-hover:text-[var(--color-accent-400)]">{num}</span>
    <div class="flex flex-col gap-1.5">
      <h3 class:list={['transition-colors group-hover:text-[var(--color-accent-200)]', tile === 'wide' ? 'text-xl' : 'text-base']}>{title}</h3>
      <p class:list={['max-w-[46ch] text-[var(--color-ink-400)] transition-colors group-hover:text-[var(--color-ink-300)]', tile === 'wide' ? 'text-[15px]' : 'text-sm']}>
        {summary}
      </p>
      {tile === 'wide' && (
        <div class="mt-1 flex flex-wrap gap-1.5 card-tags">
          {stack.map((s) => (
            <span class="tag tag-outline">{s}</span>
          ))}
        </div>
      )}
    </div>
  </div>
</a>
