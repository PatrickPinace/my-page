---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---

<div class="px-6 pb-16 md:px-14 md:pb-18">
  <div class="mb-7 flex items-baseline justify-between">
    <h2 id="projekty" class="text-[28px] md:text-[40px]">Projekty</h2>
    <span class="hidden text-[13px] text-[var(--color-neutral-500)] md:inline">sześć rzeczy, które postawiłem i utrzymuję</span>
  </div>

  <div class="grid grid-cols-1 gap-7 md:grid-cols-6 md:gap-6">
    {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
  </div>
</div>

<script>
  // Dwie niezależne rzeczy dzieją się na kaflach:
  //
  // 1. Klatki galerii projektu przewijają się w czasie (5–11 s), każdy kafel
  //    własnym rytmem, żeby siatka nie mrugała zbiorczo. Ruch pauzuje, gdy
  //    kafel jest poza ekranem albo pod kursorem - wtedy screen ma stać.
  // 2. Klatki z jasnym zrzutem mają dwie warstwy (przyciemnione pod Nocturne
  //    i pod Ruda) - która jest na wierzchu, decyduje aktywny motyw strony,
  //    nie upływ czasu.

  const applyTheme = () => {
    const isRuda = document.documentElement.dataset.theme === 'ruda';
    document.querySelectorAll<HTMLElement>('.shot-pair').forEach((el) => {
      el.classList.toggle('shot-swap', isRuda);
    });
  };

  applyTheme();
  document.addEventListener('theme-change', applyTheme);

  const cards = Array.from(document.querySelectorAll<HTMLElement>('.card-shots'));
  const motionOK = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (cards.length && motionOK) {
    const timers = new WeakMap<HTMLElement, number>();
    const indexes = new WeakMap<HTMLElement, number>();
    const delay = () => 5000 + Math.random() * 6000;

    const tick = (card: HTMLElement) => {
      const frames = Array.from(card.querySelectorAll<HTMLElement>('.card-shot'));
      if (!card.dataset.paused && frames.length > 1) {
        const next = ((indexes.get(card) ?? 0) + 1) % frames.length;
        indexes.set(card, next);
        frames.forEach((el, n) => el.classList.toggle('is-active', n === next));
      }
      timers.set(card, window.setTimeout(() => tick(card), delay()));
    };

    const stop = (card: HTMLElement) => {
      const id = timers.get(card);
      if (id) window.clearTimeout(id);
      timers.delete(card);
    };

    // Rusza dopiero, gdy kafel wjedzie w widok - i zatrzymuje się po wyjeździe.
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const card = e.target as HTMLElement;
          if (e.isIntersecting) {
            if (!timers.has(card)) {
              // losowy odstęp startowy rozjeżdża kafle względem siebie
              timers.set(card, window.setTimeout(() => tick(card), Math.random() * 4000));
            }
          } else {
            stop(card);
          }
        }
      },
      { threshold: 0.2 }
    );

    for (const card of cards) {
      if (card.querySelectorAll('.card-shot').length < 2) continue;
      io.observe(card);
      const link = card.closest('a') ?? card;
      link.addEventListener('mouseenter', () => (card.dataset.paused = '1'));
      link.addEventListener('mouseleave', () => delete card.dataset.paused);
    }
  }
</script>
