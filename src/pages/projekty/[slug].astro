---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
// pod inną nazwą - `url` jest tu zajęte przez pole z frontmattera projektu
import { url as path } from '../../lib/paths';
import { webpSize } from '../../lib/webp-size';
import { fileURLToPath } from 'node:url';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
  const n = projects.length;
  // Nawigacja zapętlona: z ostatniego projektu "dalej" wraca do pierwszego,
  // z pierwszego "wstecz" prowadzi do ostatniego - stąd modulo zamiast
  // zwykłego i ± 1, które na krańcach dawałoby undefined.
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: projects[(i - 1 + n) % n], next: projects[(i + 1) % n] },
  }));
}

const { project, prev, next } = Astro.props;
const { title, summary, stack, role, url, repo, hosting, screenshot, screenshotAlt, order, extraShots } = project.data;
const total = (await getCollection('projects')).length;
const num = String(order).padStart(2, '0');
const { Content } = await render(project);

// Karuzela: wersja ciemna i jasna zawsze, plus ewentualne dodatkowe zdjęcia.
// Wymiary czytane bezpośrednio z plików w public/screens/ (nie z URL-a -
// path() dokleja base, a plik na dysku leży pod korzeniem projektu).
const screensDir = fileURLToPath(new URL('../../../public/screens/', import.meta.url));

const shots = [
  { file: `${screenshot}-dark.webp`, src: path(`/screens/${screenshot}-dark.webp`), alt: screenshotAlt, variant: 'dark' },
  { file: `${screenshot}-light.webp`, src: path(`/screens/${screenshot}-light.webp`), alt: screenshotAlt, variant: 'light' },
  ...extraShots.map((s) => ({ file: null, src: path(s.src), alt: s.alt, variant: 'extra' })),
].map((s) => {
  if (!s.file) return { ...s, width: 1600, height: 900 }; // rozsądny domyślny - extraShots poza public/screens/
  const { width, height } = webpSize(screensDir + s.file);
  return { ...s, width, height };
});
---

<Base title={`${title} - Michał Minor`} description={summary}>
  <Header />
  <div class="mx-auto max-w-[1120px]">
    <div class="px-6 pb-16 md:px-14">
      <div class="mb-3 font-mono text-xs text-[var(--color-neutral-600)]">
        <a href={path("/#projekty")} class="text-[var(--color-neutral-600)] no-underline hover:text-[var(--color-accent-300)]">← projekty</a>
        · {num} / {String(total).padStart(2, '0')}
      </div>

      <h1 class="mb-3 text-[32px] tracking-[-0.02em] md:text-[44px]">{title}</h1>
      <p class="mb-6 max-w-[54ch] text-lg text-[var(--color-neutral-400)] md:text-[19px]">{summary}</p>

      <div class="mb-7 grid grid-cols-2 gap-5 border-y border-[var(--color-neutral-800)] py-4 text-[13px] md:grid-cols-4">
        <div>
          <div class="mb-1 text-[var(--color-neutral-500)]">Rola</div>
          {role.join(', ')}
        </div>
        <div>
          <div class="mb-1 text-[var(--color-neutral-500)]">Stack</div>
          {stack.join(' · ')}
        </div>
        <div>
          <div class="mb-1 text-[var(--color-neutral-500)]">Hosting</div>
          {hosting}
        </div>
        <div>
          <div class="mb-1 text-[var(--color-neutral-500)]">Link</div>
          {url && <a href={url} class="text-[var(--color-accent-300)] no-underline">na żywo →</a>}
          {repo && !url && <a href={repo} class="text-[var(--color-accent-300)] no-underline">repo →</a>}
        </div>
      </div>

      <div class="shot-gallery relative mb-7 overflow-hidden rounded-[var(--radius-md)] shadow-[var(--shadow-md)]">
        <!-- Kontener nie ma stałych proporcji - dostaje aspect-ratio
             aktywnego zdjęcia, więc dopasowuje się do zdjęcia (bez pustego
             tła po bokach), a nie odwrotnie. Wartość startowa (pierwszy shot)
             renderuje się od razu z serwera, żeby nic nie skakało przy
             ładowaniu; skrypt zmienia ją przy każdym przełączeniu klatki.
             Tło (color-surface) siedzi tu, na .shot-frame, a nie na
             .shot-gallery - inaczej rosło z całym kontenerem 1120px i dawało
             szare pasy po bokach węższego zdjęcia. -->
        <div
          class:list={['shot-frame relative mx-auto flex max-h-[70vh] w-fit max-w-full items-center justify-center', shots.length > 1 && 'cursor-pointer']}
          style={`aspect-ratio: ${shots[0].width} / ${shots[0].height}; background: var(--color-surface)`}
          data-ratios={JSON.stringify(shots.map((s) => `${s.width} / ${s.height}`))}
        >
          {shots.map((s, i) => (
            <img
              src={s.src}
              alt={s.alt}
              width={s.width}
              height={s.height}
              class:list={['shot', `shot-${s.variant}`, 'block h-full w-full object-contain', i === 0 && 'is-active']}
            />
          ))}

          <!-- Strzałki wycentrowane na wysokości zdjęcia, nie całej galerii -
               dlatego siedzą w .shot-frame, a nie bezpośrednio w .shot-gallery.
               Chowają się same, gdy klatka jest tylko jedna (.has-single). -->
          <button type="button" class="shot-arrow shot-arrow-prev" aria-label="Poprzednie zdjęcie">‹</button>
          <button type="button" class="shot-arrow shot-arrow-next" aria-label="Następne zdjęcie">›</button>
        </div>

        <!-- Pasek pod zdjęciem, osobne miejsce na pauzę/kropki - nie nachodzi na kadr. -->
        <div class="shot-controls">
          <button type="button" class="shot-play" aria-label="Zatrzymaj automatyczną zmianę zdjęć">
            <span class="icon-pause">⏸</span>
            <span class="icon-play">▶</span>
          </button>
          <div class="shot-dots" role="tablist" aria-label="Wybór zdjęcia">
            {shots.map((s, i) => (
              <button
                type="button"
                class:list={['shot-dot', i === 0 && 'is-active']}
                data-index={i}
                aria-label={`Zdjęcie ${i + 1} z ${shots.length}`}
                aria-selected={i === 0 ? 'true' : 'false'}
              />
            ))}
          </div>
        </div>
      </div>

      {/* Nawigacja między projektami zaraz pod zdjęciem/kontrolkami galerii -
          wcześniej siedziała na samym dole strony, oderwana od kontekstu,
          do którego się odnosi. */}
      <div class="mb-9 flex justify-between border-b border-[var(--color-neutral-900)] pb-5 text-sm">
        {prev ? (
          <a href={path(`/projekty/${prev.id}`)} class="case-nav-link text-[var(--color-neutral-400)] no-underline">← {prev.data.title}</a>
        ) : <span></span>}
        {next ? (
          <a href={path(`/projekty/${next.id}`)} class="case-nav-link text-[var(--color-accent-300)] no-underline">{next.data.title} →</a>
        ) : <span></span>}
      </div>

      {/* Przyklejone do lewej jak reszta strony (zdjęcia, nagłówek) - blok
          wyśrodkowany na środku 1120px wyglądał jak oderwana wysepka tekstu.
          Szerokość zostaje ograniczona do ~58 znaków dla wygody czytania. */}
      <div class="prose-case max-w-[58ch] text-[16px] leading-relaxed">
        <Content />
      </div>
    </div>

    <Footer />
  </div>
</Base>

<script>
  // Nawigacja prev/next między projektami to zwykłe przeładowanie strony,
  // więc przeglądarka domyślnie wraca na górę. Zapisujemy pozycję scrolla
  // pod kluczem docelowego URL-a tuż przed opuszczeniem strony i odtwarzamy
  // ją, jeśli wpis czeka - po jednym użyciu wpis kasujemy, żeby zwykłe
  // wejście na podstronę (np. z kafelka) zawsze startowało od góry.
  const SCROLL_KEY_PREFIX = 'scrollTo:';

  document.querySelectorAll<HTMLAnchorElement>('.case-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      sessionStorage.setItem(SCROLL_KEY_PREFIX + link.href, String(window.scrollY));
    });
  });

  const savedY = sessionStorage.getItem(SCROLL_KEY_PREFIX + location.href);
  if (savedY !== null) {
    sessionStorage.removeItem(SCROLL_KEY_PREFIX + location.href);
    window.scrollTo(0, Number(savedY));
  }
</script>

<script>
  // Karuzela: strzałki, kropki, klik w połowę zdjęcia i strzałki klawiatury
  // dla nawigacji ręcznej; autoplay w tle (13–19 s na klatkę) dopóki nikt
  // nie kliknął pauzy ani nie najechał kursorem. Zatrzymuje się też poza
  // ekranem, żeby nie tykać w tle.
  const gallery = document.querySelector<HTMLElement>('.shot-gallery');
  const motionOK = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (gallery) {
    const frame = gallery.querySelector<HTMLElement>('.shot-frame')!;
    const ratios = JSON.parse(frame.dataset.ratios ?? '[]') as string[];
    const shots = Array.from(gallery.querySelectorAll<HTMLElement>('.shot'));
    const dots = Array.from(gallery.querySelectorAll<HTMLButtonElement>('.shot-dot'));
    const prevBtn = gallery.querySelector<HTMLButtonElement>('.shot-arrow-prev');
    const nextBtn = gallery.querySelector<HTMLButtonElement>('.shot-arrow-next');
    const playBtn = gallery.querySelector<HTMLButtonElement>('.shot-play');

    if (shots.length < 2) {
      gallery.classList.add('has-single');
    }

    let index = 0;
    let timer = 0;
    let userPaused = false;
    let inView = true;

    const show = (i: number) => {
      index = (i + shots.length) % shots.length;
      shots.forEach((el, n) => el.classList.toggle('is-active', n === index));
      dots.forEach((el, n) => {
        el.classList.toggle('is-active', n === index);
        el.setAttribute('aria-selected', String(n === index));
      });
      if (ratios[index]) frame.style.aspectRatio = ratios[index];
    };

    const stop = () => {
      window.clearTimeout(timer);
      timer = 0;
    };

    const schedule = () => {
      stop();
      if (!motionOK || userPaused || !inView || shots.length < 2) return;
      timer = window.setTimeout(() => {
        show(index + 1);
        schedule();
      }, 13000 + Math.random() * 6000);
    };

    const goTo = (i: number) => {
      show(i);
      schedule();
    };

    prevBtn?.addEventListener('click', () => goTo(index - 1));
    nextBtn?.addEventListener('click', () => goTo(index + 1));
    dots.forEach((dot, n) => dot.addEventListener('click', () => goTo(n)));

    // Klik w lewą/prawą połowę zdjęcia, żeby nie trzeba było celować
    // w wąską strzałkę. Nie łapie kliknięć na samych strzałkach/kropkach -
    // te mają własne listenery i closest() je wyłapuje wcześniej.
    frame.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('.shot-arrow') || shots.length < 2) return;
      const rect = frame.getBoundingClientRect();
      const clickedLeft = (e as MouseEvent).clientX - rect.left < rect.width / 2;
      goTo(index + (clickedLeft ? -1 : 1));
    });

    // Strzałki klawiatury, gdy galeria (lub coś w niej) ma fokus.
    gallery.setAttribute('tabindex', '0');
    gallery.addEventListener('keydown', (e) => {
      if (shots.length < 2) return;
      if (e.key === 'ArrowLeft') goTo(index - 1);
      if (e.key === 'ArrowRight') goTo(index + 1);
    });

    playBtn?.addEventListener('click', () => {
      userPaused = !userPaused;
      gallery.classList.toggle('is-paused', userPaused);
      schedule();
    });

    gallery.addEventListener('mouseenter', stop);
    gallery.addEventListener('mouseleave', schedule);

    new IntersectionObserver(
      ([e]) => {
        inView = e.isIntersecting;
        inView ? schedule() : stop();
      },
      { threshold: 0.2 }
    ).observe(gallery);

    show(0);
  }
</script>

<style>
  .prose-case :global(h2) {
    margin: 28px 0 8px;
    font-size: 14px;
    color: var(--color-neutral-500);
    font-weight: 500;
  }
  .prose-case :global(p) {
    margin: 0 0 4px;
    color: var(--color-neutral-300);
  }
</style>
