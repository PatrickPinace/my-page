---
import '../styles/global.css';
import { url } from '../lib/paths';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Astro.site pochodzi z SITE_URL - bez niego zostaje localhost i tagi
// kanoniczne po prostu nie mają sensu w produkcji.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/photo/michal-minor.webp', Astro.site);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e0f17" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Musi wykonać się przed pierwszym malowaniem, inaczej strona mignie
      // domyślnym motywem, zanim wczyta się zapisany wybór.
      try {
        var t = localStorage.getItem('theme');
        if (t === 'ruda') {
          document.documentElement.dataset.theme = 'ruda';
          document
            .querySelector('meta[name="theme-color"]')
            .setAttribute('content', '#14120f');
        }
      } catch (e) {}
    </script>
    <script is:inline>
      // Przywrócenie zapamiętanej pozycji scrolla (nawigacja prev/next między
      // projektami). scrollTo() nie ma efektu, dopóki <body> nie istnieje -
      // dokument nie ma jeszcze wysokości do przewinięcia - więc nie można
      // tego zrobić tu, w <head>. Zamiast tego chowamy stronę (visibility)
      // do czasu, aż skrypt na końcu <body> zdąży ustawić scroll: przeglądarka
      // nigdy nie maluje "złej", nieprzewiniętej klatki, więc nie widać
      // charakterystycznego skoku/wysunięcia treści.
      // scrollRestoration wyłączone, żeby wbudowany mechanizm przeglądarki
      // nie kłócił się z naszym ręcznym przywracaniem.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      try {
        if (sessionStorage.getItem('scrollTo:' + location.href) !== null) {
          document.documentElement.style.visibility = 'hidden';
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      // Druga połowa przywracania scrolla (patrz komentarz w <head>) - w tym
      // miejscu <body> już istnieje, ale obrazy (zdjęcia w karuzeli) mogą
      // wciąż się ładować, więc dokument nie ma jeszcze docelowej wysokości -
      // scrollTo() przed pełnym załadowaniem trafiał w za krótką stronę i
      // później zjeżdżał, gdy obraz doładował layout. Stąd restore czeka na
      // window.load (albo, gdy strona jest już complete, wykonuje się od
      // razu) - dopiero wtedy odsłaniamy stronę.
      (function () {
        var key = 'scrollTo:' + location.href;
        var savedY = null;
        try {
          savedY = sessionStorage.getItem(key);
        } catch (e) {}

        var restore = function () {
          try {
            if (savedY !== null) {
              sessionStorage.removeItem(key);
              window.scrollTo(0, Number(savedY));
            }
          } catch (e) {}
          document.documentElement.style.visibility = '';
        };

        if (savedY !== null && document.readyState !== 'complete') {
          window.addEventListener('load', restore, { once: true });
        } else {
          restore();
        }
      })();
    </script>
    <script>
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            entry.target.classList.toggle('is-visible', entry.isIntersecting);
          }
        },
        { threshold: 0.15 }
      );
      els.forEach((el) => io.observe(el));
    </script>
  </body>
</html>
